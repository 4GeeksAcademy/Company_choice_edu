{
  "name": "healthcore-digital",
  "private": true,
  "workspaces": [
    "packages/shared",
    "uis/website",
    "uis/backoffice"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace=@healthcore/website",
    "dev:backoffice": "npm run dev --workspace=@healthcore/backoffice",
